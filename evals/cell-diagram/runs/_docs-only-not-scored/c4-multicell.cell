title Storefront

cell orders as "Order Cell" {
  version v2

  component api as "Orders API" api
  component odb as "Order DB" database

  north customerApp as "Customer App" web-app
  south s3 as "AWS S3" storage

  customerApp -> api : HTTPS
  api -> odb
  api -> s3 : archive
}

cell products {
  component api as "Products API" api
  component pdb as "Catalog DB" database

  south s3 as "AWS S3" storage

  api -> pdb
  api -> s3 : archive
}

orders.api -> products.api : get stock
