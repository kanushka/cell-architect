title Storefront

cell orders as "Order Cell" {
  version v2
  component api as "Orders API" api
  component odb as "Order Store" database
  north customerApp as "Customer App" webapp

  customerApp -> api : HTTPS
  api -> odb
  api -> east s3 : archive
}

cell products {
  component api as "Products API" api
  component cstore as "Catalog Store" database
  south s3 as "AWS S3" storage

  api -> cstore
  api -> s3 : archive
}

orders.api -> products.api : get stock
