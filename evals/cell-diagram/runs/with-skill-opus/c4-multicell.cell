title Storefront

cell orders as "Order Cell" {
  version v2

  component api as "Orders API" api
  component odb as "Order Database" database
  component customerApp as "Customer App" webapp

  south s3 as "AWS S3" storage

  north -> customerApp
  customerApp -> api
  api -> odb
  api -> s3 : archive

  api -> products.api : get stock levels
}

cell products as "Products Cell" {
  component api as "Products API" api
  component pdb as "Catalog Database" database

  south s3 as "AWS S3" storage

  api -> pdb
  api -> s3 : archive
}
