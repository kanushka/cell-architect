{
  "name": "@kanushka/cell-diagram-react",
  "version": "0.3.0",
  "description": "React component and DSL for rendering cell architecture diagrams",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanushka/cell-architect.git",
    "directory": "packages/cell-diagram-react"
  },
  "homepage": "https://github.com/kanushka/cell-architect#readme",
  "bugs": {
    "url": "https://github.com/kanushka/cell-architect/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
